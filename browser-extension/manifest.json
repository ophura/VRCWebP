{
  "manifest_version": 3,
  "name": "VRCWebP Browser Bridge",
  "version": "1.1.13",
  "description": "Share only your VRChat session with the local VRCWebP app.",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "activeTab"
  ],
  "host_permissions": [
    "https://vrchat.com/*",
    "https://www.vrchat.com/*",
    "https://api.vrchat.com/*",
    "https://api.vrchat.cloud/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "vrcwebp@local.bridge",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_title": "Connect VRCWebP",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png",
    "16": "icon.png",
    "128": "icon.png"
  }
}
